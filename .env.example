# --- Gemini ---
GEMINI_API_KEY=buraya-gemini-api-key
# Geçerli modelleri görmek için: python -m yorumbot models
GEMINI_MODEL=gemini-flash-latest

# --- Google İşletme Profili ---
# Google Cloud'dan indirdiğiniz OAuth "Desktop app" istemci dosyası
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
# "python -m yorumbot locations" komutunun verdiği değer, örn: accounts/123/locations/456
GOOGLE_LOCATION=

# --- Davranış ---
# Cevap talimatlarınızı yazdığınız dosya
PROMPT_FILE=prompt.txt
# true: cevapları sadece ekrana yazar, Google'a göndermez (önce böyle deneyin)
DRY_RUN=true
# Sadece bu yıldız ve üstü yorumlara otomatik cevap ver (1-5). 1 = hepsi
MIN_STARS=1
# watch modunda kaç saniyede bir kontrol edilsin
POLL_SECONDS=600
